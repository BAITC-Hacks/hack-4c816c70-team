# Скопируйте в .env: cp .env.example .env
# Секреты не нужны. Не коммитьте .env.

# Порты на хосте (внутри контейнеров API слушает 8080, frontend — 3000)
API_PORT=8080
FRONTEND_PORT=3000

# Окружение ASP.NET Core: Production | Development
ASPNETCORE_ENVIRONMENT=Production

# Адрес API для браузера; встраивается в сборку Next.js (после изменения нужен --build)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Режим объяснения результата. mock — детерминированный шаблон по посчитанным числам,
# без внешних вызовов и ключей. Сейчас это единственный реализованный режим.
LLM_MODE=mock

# Зарезервировано для будущего подключения LLM; в mock оставьте пустым.
OPENAI_API_KEY=
