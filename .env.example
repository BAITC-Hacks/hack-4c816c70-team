# Скопируйте в .env: cp .env.example .env
# Для mock секреты не нужны. Не коммитьте .env и не публикуйте его содержимое.

# Порты на хосте (внутри контейнеров API слушает 8080, frontend — 3000)
API_PORT=8080
FRONTEND_PORT=3000

# Допустимый origin frontend для CORS; можно несколько адресов через запятую.
# Пусто — http://localhost:<FRONTEND_PORT>. Для опубликованного frontend укажите его HTTPS-адрес.
FRONTEND_ORIGIN=

# Окружение ASP.NET Core: Production | Development
ASPNETCORE_ENVIRONMENT=Production

# Адрес API для браузера; встраивается в сборку Next.js (после изменения нужен --build)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Режим объяснения: mock — шаблон без внешних вызовов и ключей (по умолчанию);
# live — OpenAI Responses API, при ошибке API возвращает шаблон mock.
LLM_MODE=mock

# Только для live. Ключ вписывайте в локальный .env, не в .env.example.
OPENAI_API_KEY=
# Для live нужно имя модели, доступной выданному ключу.
OPENAI_MODEL=
# Необязательно: прокси или локальная заглушка; пусто — https://api.openai.com/v1/
OPENAI_BASE_URL=
